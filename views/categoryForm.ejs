<%- include('partials/head') %>
<%- include('partials/nav') %>

<%
  // One template, two jobs. An existing id means edit; no id means create.
  const isEdit = Boolean(category.id);
  const action = isEdit ? `/categories/${category.id}/edit` : "/categories/new";
%>

<main class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-7">
      <h1 class="h3 mb-4"><%= isEdit ? "Edit category" : "New category" %></h1>

      <% if (errors.length > 0) { %>
        <div class="alert alert-danger">
          <ul class="mb-0 ps-3">
            <% errors.forEach((error) => { %>
              <li><%= error.msg %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <form action="<%= action %>" method="post">
            <div class="mb-3">
              <label class="form-label" for="name">Name</label>
              <input
                class="form-control"
                type="text"
                id="name"
                name="name"
                required
                maxlength="60"
                value="<%= category.name || '' %>"
              />
            </div>

            <div class="mb-4">
              <label class="form-label" for="description">Description</label>
              <textarea
                class="form-control"
                id="description"
                name="description"
                rows="3"
              ><%= category.description || '' %></textarea>
              <div class="form-text">What kind of goods belong here.</div>
            </div>

            <div class="d-flex gap-2">
              <button class="btn btn-primary" type="submit">
                <%= isEdit ? "Save changes" : "Create category" %>
              </button>
              <a
                class="btn btn-outline-secondary"
                href="<%= isEdit ? `/categories/${category.id}` : '/' %>"
                >Cancel</a
              >
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
