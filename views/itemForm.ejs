<%- include('partials/head') %>
<%- include('partials/nav') %>

<%
  const isEdit = Boolean(item.id);
  const action = isEdit ? `/items/${item.id}/edit` : "/items/new";
%>

<main class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <h1 class="h3 mb-4"><%= isEdit ? "Edit item" : "New item" %></h1>

      <% if (errors.length > 0) { %>
        <div class="alert alert-danger">
          <ul class="mb-0 ps-3">
            <% errors.forEach((error) => { %>
              <li><%= error.msg %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <form action="<%= action %>" method="post" class="row g-3">
            <div class="col-12">
              <label class="form-label" for="name">Item name</label>
              <input
                class="form-control"
                type="text"
                id="name"
                name="name"
                required
                maxlength="120"
                placeholder="e.g. Kopiko Black 3-in-1"
                value="<%= item.name || '' %>"
              />
            </div>

            <div class="col-md-7">
              <label class="form-label" for="category_id">Category</label>
              <select class="form-select" id="category_id" name="category_id">
                <!-- Empty value, not "none": the controller turns "" into NULL. -->
                <option value="">Uncategorized</option>
                <% categories.forEach((category) => { %>
                  <option
                    value="<%= category.id %>"
                    <%= String(item.category_id) === String(category.id) ? "selected" : "" %>
                  >
                    <%= category.name %>
                  </option>
                <% }) %>
              </select>
            </div>

            <div class="col-md-5">
              <label class="form-label" for="unit">Sold by</label>
              <select class="form-select" id="unit" name="unit" required>
                <% units.forEach((unit) => { %>
                  <option value="<%= unit %>" <%= item.unit === unit ? "selected" : "" %>>
                    <%= unit %>
                  </option>
                <% }) %>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label" for="price">Selling price</label>
              <div class="input-group">
                <span class="input-group-text">₱</span>
                <input
                  class="form-control"
                  type="number"
                  id="price"
                  name="price"
                  step="0.01"
                  min="0"
                  required
                  value="<%= item.price || '' %>"
                />
              </div>
            </div>

            <div class="col-md-6">
              <label class="form-label" for="cost">Buying cost</label>
              <div class="input-group">
                <span class="input-group-text">₱</span>
                <input
                  class="form-control"
                  type="number"
                  id="cost"
                  name="cost"
                  step="0.01"
                  min="0"
                  value="<%= item.cost || '' %>"
                />
              </div>
              <div class="form-text">Optional. Used to show your margin.</div>
            </div>

            <div class="col-md-6">
              <label class="form-label" for="quantity">Quantity on hand</label>
              <input
                class="form-control"
                type="number"
                id="quantity"
                name="quantity"
                step="1"
                min="0"
                required
                value="<%= item.quantity ?? 0 %>"
              />
            </div>

            <div class="col-md-6">
              <label class="form-label" for="low_stock_at">Warn me at</label>
              <input
                class="form-control"
                type="number"
                id="low_stock_at"
                name="low_stock_at"
                step="1"
                min="0"
                required
                value="<%= item.low_stock_at ?? 5 %>"
              />
              <div class="form-text">Shows in "Needs restocking" at or below this.</div>
            </div>

            <div class="col-12 d-flex gap-2 pt-2">
              <button class="btn btn-primary" type="submit">
                <%= isEdit ? "Save changes" : "Add item" %>
              </button>
              <a
                class="btn btn-outline-secondary"
                href="<%= isEdit ? `/items/${item.id}` : '/items' %>"
                >Cancel</a
              >
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
