<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="container py-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/">Categories</a></li>
      <li class="breadcrumb-item active" aria-current="page"><%= category.name %></li>
    </ol>
  </nav>

  <div class="d-flex flex-wrap justify-content-between align-items-start mb-4 gap-2">
    <div>
      <h1 class="h3 mb-1"><%= category.name %></h1>
      <p class="text-body-secondary mb-0"><%= category.description || 'No description.' %></p>
    </div>

    <div class="btn-group">
      <a class="btn btn-outline-secondary btn-sm" href="/categories/<%= category.id %>/edit">
        <i class="bi bi-pencil me-1"></i>Edit
      </a>
      <a class="btn btn-outline-danger btn-sm" href="/categories/<%= category.id %>/delete">
        <i class="bi bi-trash me-1"></i>Delete
      </a>
    </div>
  </div>

  <% if (items.length === 0) { %>
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center py-5">
        <p class="text-body-secondary">Nothing in this category yet.</p>
        <a class="btn btn-primary" href="/items/new">Add an item</a>
      </div>
    </div>
  <% } else { %>
    <div class="card border-0 shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col">Item</th>
              <th scope="col">Unit</th>
              <th scope="col" class="text-end">Price</th>
              <th scope="col">Stock</th>
              <th scope="col" class="text-end">Actions</th>
            </tr>
          </thead>

          <tbody>
            <% items.forEach((item) => { %>
              <tr>
                <td>
                  <a class="text-decoration-none fw-medium" href="/items/<%= item.id %>">
                    <%= item.name %>
                  </a>
                </td>
                <td class="text-body-secondary"><%= item.unit %></td>
                <td class="text-end"><%= peso(item.price) %></td>
                <td><%- include('partials/stockBadge', { item }) %></td>
                <td class="text-end">
                  <a class="btn btn-sm btn-outline-secondary" href="/items/<%= item.id %>/edit">
                    Edit
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
