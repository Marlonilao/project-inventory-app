<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <h1 class="h3 mb-3">Delete <%= item.name %>?</h1>

      <div class="alert alert-warning">
        This removes the item and its <%= item.quantity %> <%= item.unit %>(s) on
        hand from the inventory. It cannot be undone.
      </div>

      <div class="card border-danger-subtle shadow-sm">
        <div class="card-body">
          <form action="/items/<%= item.id %>/delete" method="post">
            <div class="mb-3">
              <label class="form-label" for="admin_password">Admin password</label>
              <input
                class="form-control"
                type="password"
                id="admin_password"
                name="admin_password"
                required
                autocomplete="off"
              />
            </div>

            <div class="d-flex gap-2">
              <button class="btn btn-danger" type="submit">Delete item</button>
              <a class="btn btn-outline-secondary" href="/items/<%= item.id %>">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
